{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourmuz",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "build": {"command": "npm run build"},
  // The built site is served by Workers Static Assets. Only API paths and the owner login run the Worker.
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/owner-login"],
  },
  // AUCTION_OWNER_EMAIL, CF_ACCESS_AUD and the Stripe keys are Worker secrets (wrangler secret put), never committed.
  "vars": {"APP_ORIGIN": "https://ishormuzopen.fun"},
  // Once the zone ishormuzopen.fun is active in this Cloudflare account, uncomment to bind it on deploy.
  // "routes": [{ "pattern": "ishormuzopen.fun", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hourmuz",
      "database_id": "365041da-91d0-47f4-8db9-9d6e7fe5af32",
      "migrations_dir": "drizzle",
    },
  ],
}
