{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourmuz",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "build": {"command": "npm run build"},
  // The built site is served by Workers Static Assets. Only API paths and the owner login run the Worker.
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/owner-login"],
  },
  // Set APP_ORIGIN, AUCTION_OWNER_EMAIL and CF_ACCESS_AUD as variables and the Stripe keys as secrets in Worker settings.
  // Add the D1 binding after creating the database in the selected Cloudflare account.
  "d1_databases": [],
}
