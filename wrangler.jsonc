{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourmuz",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "build": {"command": "npm run build"},
  // The built site is served by Workers Static Assets. Only API paths and the owner login run the Worker.
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/owner-login"],
  },
  // Set APP_ORIGIN, AUCTION_OWNER_EMAIL and CF_ACCESS_AUD as variables and the Stripe keys as secrets in Worker settings.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hourmuz",
      "database_id": "365041da-91d0-47f4-8db9-9d6e7fe5af32",
      "migrations_dir": "drizzle",
    },
  ],
}
